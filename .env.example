LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For local testing from the same machine:
LIVEKIT_URL_PUBLIC=ws://localhost:7880
LIVEKIT_URL_INTERNAL=ws://livekit:7880
LIVEKIT_NODE_IP=127.0.0.1

TOKEN_SERVER_PORT=8000
FRONTEND_PORT=8080

TOKEN_TTL_MINUTES=60
CORS_ALLOW_ORIGINS=*

AGENT_ROOM=demo-room
AGENT_IDENTITY=agent-001
AGENT_NAME=Room Agent
AGENT_READY_TOPIC=presence
TOKEN_SERVER_INTERNAL_URL=http://token_server:8000/token
TOKEN_REQUEST_TIMEOUT=10

# Route every meaningful turn through the manager LLM.
LLM_ORCHESTRATES_ALL=true
LLM_MAX_TOKENS=4096
LLM_DEBUG_DIRECT_MODE=false
SUPERVISOR_ENABLED=false
SUPERVISOR_MODEL=Qwen/Qwen2.5-3B-Instruct
SUPERVISOR_BASE_URL=http://127.0.0.1:8001/v1
SUPERVISOR_MAX_TOKENS=256
SUPERVISOR_SOFT_TIMEOUT_MS=450
