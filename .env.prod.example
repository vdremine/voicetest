SERVER_TIMEZONE=Europe/Moscow

SERVER_PUBLIC_IP=203.0.113.10
APP_DOMAIN=app.example.com
LIVEKIT_DOMAIN=livekit.example.com

LIVEKIT_API_KEY=voice-agent-prod
LIVEKIT_API_SECRET=replace-with-long-random-secret

# Public LiveKit endpoint returned by token_server.
LIVEKIT_URL_PUBLIC=wss://livekit.example.com

LIVEKIT_USE_EXTERNAL_IP=true

TOKEN_TTL_MINUTES=60
CORS_ALLOW_ORIGINS=*

AGENT_ROOM=demo-room
AGENT_IDENTITY=agent-001
AGENT_NAME=Room Agent
AGENT_READY_TOPIC=presence
TOKEN_REQUEST_TIMEOUT=10
CONNECT_RETRY_DELAY=2
AGENT_EVENTS_TOPIC=agent_events

MODEL_CACHE_DIR=/opt/models
VOICE_AGENT_DATA_DIR=/opt/voice-agent-data

AUDIO_SAMPLE_RATE=16000
AUDIO_NUM_CHANNELS=1
AUDIO_FRAME_SIZE_MS=20

VAD_THRESHOLD=0.45
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=900
VAD_SPEECH_PAD_MS=200
PROCESSING_RESUME_MIN_SPEECH_DURATION_MS=450
BARGE_IN_MIN_SPEECH_DURATION_MS=280
VAD_USE_ONNX=false
TORCH_NUM_THREADS=1

STT_ENABLED=true
# Движок STT: whisper (faster-whisper) | gigaam (Sber, локально, лучше на русском
# и числах, без галлюцинаций "Спасибо за просмотр"). gigaam — через onnx-asr.
STT_BACKEND=whisper
# Для whisper: large-v3 точнее medium (~3GB VRAM). turbo: deepdml/faster-whisper-large-v3-turbo-ct2
STT_MODEL=Systran/faster-whisper-large-v3
# Для gigaam (если STT_BACKEND=gigaam): gigaam-v3-rnnt | gigaam-v3-e2e-rnnt (авто-числа) | gigaam-v2-rnnt
STT_GIGAAM_MODEL=gigaam-v3-rnnt
STT_DEVICE=cuda
STT_COMPUTE_TYPE_CPU=int8
STT_COMPUTE_TYPE_GPU=float16
STT_LANGUAGE=ru
STT_BEAM_SIZE=3
STT_CONFIDENCE_FLOOR=0.25
DEBUG_SAVE_WAV=false

LLM_ENABLED=true
# Local/OpenAI-compatible LLM:
LLM_PROVIDER=openai
# ВАЖНО: голос идёт через новый диалоговый движок call_agent (текстовый API 8787).
# legacy = старый agent_core. Для рабочей версии — text_api.
DIALOGUE_BACKEND=text_api
TEXT_API_URL=http://127.0.0.1:8787
# 14B-AWQ: ~10GB весов, заметно надёжнее 7B по извлечению фактов, легко делит 48GB GPU с STT/TTS.
# Для максимального качества можно fp16: Qwen/Qwen2.5-14B-Instruct + GPU_MEMORY_UTILIZATION=0.70.
# ДООБУЧЕННАЯ модель «Дмитрий»: ставь LLM_MODEL=mif и подними vLLM через
# finetune/serve_vllm.sh (отдаёт qwen-mif-merged). Подробности: finetune/README.md.
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=15
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=local-token
LLM_PROJECT=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=256
TOOL_GRAPH_PATH=/app/voice_agent_graph_v0_1/tool_graph.json
# 0.55 на 48GB = ~26GB под vLLM (10 веса + 16 KV), остальное свободно под STT/TTS на той же карте.
LLM_GPU_MEMORY_UTILIZATION=0.55
# Системный промпт call_agent ~3.5k токенов — 4096 впритык, берём 8192.
LLM_MAX_MODEL_LEN=8192
LLM_MAX_NUM_SEQS=1
ADAPTIVE_CLASSIFIER_ENABLED=false
OPENAI_API_KEY=

TTS_ENABLED=true
TTS_MODEL_PATH=/models/silero-tts/ru/v5_4_ru.pt
TTS_MODEL_URL=https://models.silero.ai/models/tts/ru/v5_4_ru.pt
TTS_SPEAKER=aidar
# Скорость речи (быстрее в среднем). Ударения ставятся автоматически (put_accent).
TTS_SPEED=1.12
TTS_DEVICE=cuda
TTS_SAMPLE_RATE=24000
TTS_PUBLISH_SAMPLE_RATE=24000
TTS_FRAME_MS=20
# silero (быстрый, роботичный) | piper (быстрый, живее, локальный) |
# omnivoice (самый живой, но диффузия — медленный, ~секунды на реплику)
TTS_PROVIDER=piper
TTS_SEGMENT_PAUSE_MS=240
TTS_NORMALIZE_PEAK=0.8
TTS_FADE_MS=8

# --- OmniVoice (если TTS_PROVIDER=omnivoice) ---
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_DTYPE=float16
# diffusion-шаги: меньше = быстрее синтез, чуть ниже качество. 4 (макс скорость) .. 16 (качество)
OMNIVOICE_NUM_STEP=6
# instruct = английские атрибуты через запятую, напр. "male, low pitch". Обучен на
# ZH/EN — для русского даёт акцент. Пусто = auto-voice (родной русский голос).
OMNIVOICE_INSTRUCT=
# Лучший способ зафиксировать конкретный голос — референс-аудио (клон):
# OMNIVOICE_REF_AUDIO=/models/voices/broker_ref.wav

# --- Piper (если TTS_PROVIDER=piper) — быстрый локальный нейро-TTS ---
# мужские русские голоса: ru_RU-dmitri-medium, ru_RU-denis-medium, ru_RU-ruslan-medium
PIPER_MODEL=ru_RU-dmitri-medium
PIPER_MODEL_DIR=/models/piper
PIPER_USE_CUDA=true
# скорость речи: <1.0 = быстрее (length_scale делится на TTS_SPEED)
PIPER_LENGTH_SCALE=0.95

HALF_DUPLEX=false
BARGE_IN_ENABLED=true
# "Алло, вы на связи?" после стольких мс ПОЛНОЙ тишины (нет речи вообще). 0 = выкл.
# Шум/музыка (речь есть, но не распознать) обрабатывается отдельно всегда.
IDLE_PROMPT_MS=0
# Мягкий звук при перебивании (как переключение на телефоне): click | beep | none
BARGE_IN_CUE=click
BARGE_IN_CUE_MS=45
BARGE_IN_CUE_VOLUME=0.18
VOICE_FILLERS_ENABLED=false
VOICE_FILLERS_LEVEL=light
VOICE_FILLERS_PROBABILITY=0.35
VOICE_BRIDGE_ON_LLM=false
