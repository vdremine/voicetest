SERVER_TIMEZONE=Europe/Moscow

SERVER_PUBLIC_IP=203.0.113.10
APP_DOMAIN=app.example.com
LIVEKIT_DOMAIN=livekit.example.com

LIVEKIT_API_KEY=voice-agent-prod
LIVEKIT_API_SECRET=replace-with-long-random-secret
LIVEKIT_URL_PUBLIC=wss://livekit.example.com
LIVEKIT_USE_EXTERNAL_IP=true

TOKEN_TTL_MINUTES=60
CORS_ALLOW_ORIGINS=*

AGENT_ROOM=demo-room
AGENT_IDENTITY=agent-yandex-gpu-001
AGENT_NAME=Yandex GPU Agent
AGENT_READY_TOPIC=presence
TOKEN_REQUEST_TIMEOUT=10
CONNECT_RETRY_DELAY=2
AGENT_EVENTS_TOPIC=agent_events

MODEL_CACHE_DIR=/opt/models
VOICE_AGENT_DATA_DIR=/opt/voice-agent-data

AUDIO_SAMPLE_RATE=16000
AUDIO_NUM_CHANNELS=1
AUDIO_FRAME_SIZE_MS=20

VAD_THRESHOLD=0.45
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=900
VAD_SPEECH_PAD_MS=200
PROCESSING_RESUME_MIN_SPEECH_DURATION_MS=1200
BARGE_IN_MIN_SPEECH_DURATION_MS=500
VAD_USE_ONNX=false
TORCH_NUM_THREADS=1

STT_ENABLED=true
STT_MODEL=Systran/faster-whisper-medium
STT_DEVICE=cuda
STT_COMPUTE_TYPE_CPU=int8
STT_COMPUTE_TYPE_GPU=float16
STT_LANGUAGE=ru
STT_BEAM_SIZE=3
STT_CONFIDENCE_FLOOR=0.25
DEBUG_SAVE_WAV=false

LLM_ENABLED=true
LLM_PROVIDER=yandex
YANDEX_IAM_TOKEN=
YANDEX_API_KEY=replace-with-yandex-api-key
YANDEX_PROJECT_ID=replace-with-yandex-folder-id
YANDEX_PROMPT_ID=
YANDEX_ASSISTANT_ID=replace-with-yandex-assistant-id
YANDEX_ASSISTANT_BASE_URL=https://rest-assistant.api.cloud.yandex.net/assistants/v1
LLM_PROJECT=
LLM_REASONING_EFFORT=off
LLM_TIMEOUT_SECONDS=20
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
ADAPTIVE_CLASSIFIER_ENABLED=false
LLM_ORCHESTRATES_ALL=true
LLM_DEBUG_DIRECT_MODE=false

SUPERVISOR_ENABLED=false
SUPERVISOR_PROVIDER=yandex
SUPERVISOR_MODEL=
SUPERVISOR_REASONING_EFFORT=off
SUPERVISOR_TIMEOUT_SECONDS=8
SUPERVISOR_BASE_URL=
SUPERVISOR_API_KEY=
SUPERVISOR_PROJECT=
SUPERVISOR_TEMPERATURE=0.1
SUPERVISOR_MAX_TOKENS=256
SUPERVISOR_SOFT_TIMEOUT_MS=450

TTS_ENABLED=true
TTS_PROVIDER=silero
TTS_MODEL_PATH=/models/silero-tts/ru/v5_4_ru.pt
TTS_MODEL_URL=https://models.silero.ai/models/tts/ru/v5_4_ru.pt
TTS_SPEAKER=aidar
TTS_DEVICE=cuda
TTS_SAMPLE_RATE=24000
TTS_PUBLISH_SAMPLE_RATE=24000
TTS_FRAME_MS=20
TTS_SEGMENT_PAUSE_MS=120
TTS_NORMALIZE_PEAK=0.8
TTS_FADE_MS=8

HALF_DUPLEX=true
BARGE_IN_ENABLED=false
VOICE_FILLERS_ENABLED=false
VOICE_FILLERS_LEVEL=light
VOICE_FILLERS_PROBABILITY=0.35
VOICE_BRIDGE_ON_LLM=false
